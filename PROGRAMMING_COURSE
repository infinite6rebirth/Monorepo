# 3) LeetCode schedule CSV (first 8 weeks, 6 days/week)
csv_path = base / "leetcode_schedule.csv"
header = ["week","day","problem_name","difficulty","notes"]
rows = []
# We'll populate 8 weeks * 6 days, a few problems per day
week_problem_map = {
    1: ["Two Sum","Valid Parentheses","Best Time to Buy and Sell Stock","Merge Intervals"],
    2: ["Longest Substring Without Repeating Characters","Sliding Window Maximum","3Sum","Binary Search"],
    3: ["Binary Tree Level Order Traversal","Number of Islands","Course Schedule","Lowest Common Ancestor"],
    4: ["Climbing Stairs","Longest Increasing Subsequence","Coin Change","Edit Distance"],
    5: ["LRU Cache","Top K Frequent Elements","Container With Most Water","Insert Interval"],
    6: ["Serialize and Deserialize Binary Tree","Dijkstra (shortest path)","Kth Largest Element in a Stream","Merge k Sorted Lists"],
    7: ["Sliding Window Maximum","Minimum Window Substring","Evaluate Reverse Polish Notation","Valid Parentheses (revise)"],
    8: ["Median of Two Sorted Arrays (stretch)","Search in Rotated Sorted Array","Top K Frequent Words","Word Ladder"]
}
for w in range(1,9):
    problems = week_problem_map.get(w, [])
    day = 1
    for p in problems:
        rows.append([w, day, p, "medium" if "Median" in p or "Edit" in p or "LRU" in p else "easy/medium", "Practice pattern"])
        day += 1

with open(csv_path, "w", newline='') as f:
    writer = csv.writer(f)
    writer.writerow(header)
    writer.writerows(rows)

